<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Стиль для рамки обычной строки. -->
    <Style Selector="Border.tableRow">
        <Setter Property="Background" Value="{StaticResource _backgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource _borderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="45" />
    </Style>

    <!-- Стиль для рамки проблемной строки. -->
    <Style Selector="Border.tableRow.problematic">
        <Setter Property="Background" Value="{StaticResource _problematicBorderBrush}" />
    </Style>

    <!-- Стиль для выбранной строки. -->
    <Style Selector="ListBoxItem:selected Border.tableRow">
        <Setter Property="Background" Value="{StaticResource _selectedcBorderBrush}" />
    </Style>

    <!-- Стиль ListBox. -->
    <Style Selector="ListBox.tableList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Стиль для элементов ListBox. -->
    <Style Selector="ListBox.tableList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Стиль для кнопок заголовков. -->
    <Style Selector="Button.tableHeaderButton">
		<Setter Property="Theme" Value="{StaticResource _flatButtonStyle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource _secondaryTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль для заголовков. -->
    <Style Selector="TextBlock.tableHeaderText">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource _secondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль для заголовков при наведении. -->
    <Style Selector="Button.tableHeaderButton:pointerover">
        <Setter Property="Foreground" Value="{StaticResource _primaryTextBrush}" />
    </Style>

    <!-- Стиль для текстовых ячеек. -->
    <Style Selector="TextBlock.tableCellText">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource _primaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль для ячейки с Id. -->
    <Style Selector="TextBlock.tableCellText.tableMediumCellText">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Стиль для рамки бейджа статуса. -->
    <Style Selector="Border.statusBadge">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль для рамки бейджа статуса "Completed". -->
    <Style Selector="Border.statusBadge.completed">
        <Setter Property="Background" Value="{StaticResource _completedBadgeBorderBrush}" />
    </Style>

    <!-- Стиль для рамки бейджа статуса "Processing". -->
    <Style Selector="Border.statusBadge.processing">
        <Setter Property="Background" Value="{StaticResource _processingBadgeBorderBrush}" />
    </Style>

    <!-- Стиль для рамки бейджа статуса "Pending". -->
    <Style Selector="Border.statusBadge.pending">
        <Setter Property="Background" Value="{StaticResource _pendingBadgeBorderBrush}" />
    </Style>

    <!-- Стиль для рамки бейджа статуса "Failed". -->
    <Style Selector="Border.statusBadge.failed">
        <Setter Property="Background" Value="{StaticResource _problematicBorderBrush}" />
    </Style>

    <!-- Стиль для рамки бейджа ошибки. -->
    <Style Selector="Border.statusBadge.error">
        <Setter Property="Background" Value="{StaticResource _redErrorBackgroundBrush}" />
    </Style>

    <!-- Стиль для рамки бейджа предупреждения. -->
    <Style Selector="Border.statusBadge.warning">
        <Setter Property="Background" Value="{StaticResource _warningBackgroundBrush}" />
    </Style>
    
    <!-- Стиль для текста бейджа статуса. -->
    <Style Selector="TextBlock.statusText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль для текста бейджа статуса "Completed". -->
    <Style Selector="TextBlock.statusText.completed">
        <Setter Property="Foreground" Value="{StaticResource _completedBadgeTextBrush}" />
    </Style>

    <!-- Стиль для текста бейджа статуса "Processing". -->
    <Style Selector="TextBlock.statusText.processing">
        <Setter Property="Foreground" Value="{StaticResource _processingBadgeTextBrush}" />
    </Style>

    <!-- Стиль для текста бейджа статуса "Pending". -->
    <Style Selector="TextBlock.statusText.pending">
        <Setter Property="Foreground" Value="{StaticResource _pendingBadgeTextBrush}" />
    </Style>

    <!-- Стиль для текста бейджа статуса "Failed". -->
    <Style Selector="TextBlock.statusText.failed">
        <Setter Property="Foreground" Value="{StaticResource _errorBadgeTextBrush}" />
    </Style>

    <!-- Стиль для текста бейджа ошибки. -->
    <Style Selector="TextBlock.statusText.error">
        <Setter Property="Foreground" Value="{StaticResource _redErrorBrush}" />
    </Style>

    <!-- Стиль для текста бейджа предупреждения. -->
    <Style Selector="TextBlock.statusText.warning">
        <Setter Property="Foreground" Value="{StaticResource _warningBrush}" />
    </Style>
</Styles>
