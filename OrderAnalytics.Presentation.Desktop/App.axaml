<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OrderAnalytics.Presentation.Desktop.App"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://OrderAnalytics.Presentation.Desktop/Resources/Dictionaries/ColorDictionary.axaml" />
                <ResourceInclude Source="avares://OrderAnalytics.Presentation.Desktop/Resources/Dictionaries/ImageDictionary.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="avares://OrderAnalytics.Presentation.Desktop/Resources/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="avares://OrderAnalytics.Presentation.Desktop/Resources/Styles/NavigationStyles.axaml" />
    </Application.Styles>
</Application>